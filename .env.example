# Default is GloVe 6B 300d (same family as contexto.me). First seed downloads ~822MB.
# EMBEDDING_PROVIDER=glove

# MiniLM (smaller download, different ranking feel)
# EMBEDDING_PROVIDER=local

# OpenAI embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Thai uses local GloVe 300d (th.glove.300d.top30k.txt) as the playable vocabulary.
# THAI_GLOVE_FILE=/path/to/th.glove.300d.top30k.txt
# THAI_DATASET_ZIP=/path/to/thai-contexto-70k-v4.zip
# LANGUAGE=th
# npm run prepare-data:th
